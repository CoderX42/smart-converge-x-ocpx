# Copy to .env.local (already ignored by Git) and fill values from your
# deployment secret manager. Never commit .env.local.
SCX_DATASOURCE_URL=jdbc:mysql://mysql-host:3306/smart_converge_x?characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=true&serverTimezone=Asia%2FShanghai&allowMultiQueries=true
SCX_DATASOURCE_USERNAME=replace-me
SCX_DATASOURCE_PASSWORD=replace-me

# Used by the database migration and verification scripts.
MYSQL_HOST=mysql-host
MYSQL_PORT=3306
MYSQL_USERNAME=replace-me
MYSQL_PASSWORD=replace-me

SCX_REDIS_HOST=redis-host
SCX_REDIS_PORT=6379
SCX_REDIS_USERNAME=replace-me
SCX_REDIS_PASSWORD=replace-me
# Omit this variable to use database 0 in both dev and prod.
# SCX_REDIS_DATABASE=0

ROCKETMQ_NAME_SERVER=rocketmq-host:9876

# Required by the production profile.
SCX_XXL_JOB_ACCESS_TOKEN=replace-me
SCX_ENCODE_KEY=replace-me
SCX_TRACKING_CHANNEL_MASTER_KEY=replace-with-base64-32-byte-key
SCX_TRACKING_DEVICE_HMAC_KEY=replace-with-base64-at-least-32-byte-key
SCX_TRACKING_INGRESS_ENABLED=false
SCX_TRACKING_FEEDBACK_STORE=memory
SCX_TRACKING_OUTBOX_PUBLISHER_ENABLED=false
SCX_TRACKING_CALLBACK_SANDBOX_ENDPOINT=http://127.0.0.1:18080/postback
SCX_TRACKING_CALLBACK_ALLOWED_HOSTS=127.0.0.1,localhost
SCX_SANDBOX_SIGNING_KEY=replace-me-for-sandbox-only
