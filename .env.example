# Copy to .env.local (already ignored by Git) and fill values from your
# deployment secret manager. Never commit .env.local.
SCX_DATASOURCE_URL=jdbc:mysql://mysql-host:3306/smart_converge_x?characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=true&serverTimezone=Asia%2FShanghai&allowMultiQueries=true
SCX_DATASOURCE_USERNAME=replace-me
SCX_DATASOURCE_PASSWORD=replace-me

SCX_REDIS_HOST=redis-host
SCX_REDIS_PORT=6379
SCX_REDIS_USERNAME=replace-me
SCX_REDIS_PASSWORD=replace-me
# Omit this variable to use profile defaults: dev=2, prod=0.
# SCX_REDIS_DATABASE=2

# Required by the production profile.
SCX_XXL_JOB_ACCESS_TOKEN=replace-me
SCX_ENCODE_KEY=replace-me
SCX_CHANNEL_MASTER_KEY=replace-me
SCX_DEVICE_HMAC_KEY=replace-me
