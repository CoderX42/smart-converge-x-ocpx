<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yzytech.scx.ocpx.admin.mapper.OcpxBillingEntrySqlMapper">
    <sql id="filters">
        FROM scx_ocpx_billing_entry b
        JOIN scx_ocpx_advertiser a ON a.id=b.advertiser_id
        LEFT
        JOIN scx_ocpx_monitor_task t ON t.id=b.monitor_task_id
        WHERE 1=1
        <if test="q.advertiserId != null and !q.advertiserId.isBlank()">
            AND b.advertiser_id=#{q.advertiserId}
        </if>
        <if test="q.taskId != null and !q.taskId.isBlank()">
            AND b.monitor_task_id=#{q.taskId}
        </if>
        <if test="q.entryType != null and !q.entryType.isBlank()">
            AND b.entry_type=#{q.entryType}
        </if>
        <if test="q.status != null and !q.status.isBlank()">
            AND b.status=#{q.status}
        </if>
        <if test="q.businessKey != null">
            AND b.business_key LIKE CONCAT('%',
            #{q.businessKey},
            '%')
        </if>
        <if test="q.start != null">
            AND b.occurred_at&gt;=#{q.start}
        </if>
        <if test="q.end != null">
            AND b.occurred_at&lt;=#{q.end}
        </if>
    </sql>
    <select id="count" resultType="java.lang.Long" useCache="false" flushCache="true">
        SELECT COUNT(*)
        <include refid="filters"/>
    </select>
    <resultMap id="selectPageRow" type="com.yzytech.scx.ocpx.admin.mapper.OcpxBillingEntrySqlMapper$SelectPageRow">
        <constructor>
            <arg column="id" javaType="java.lang.String"/>
            <arg column="advertiser_id" javaType="java.lang.String"/>
            <arg column="advertiser_name" javaType="java.lang.String"/>
            <arg column="monitor_task_id" javaType="java.lang.String"/>
            <arg column="monitor_name" javaType="java.lang.String"/>
            <arg column="event_fact_id" javaType="java.lang.String"/>
            <arg column="entry_type" javaType="java.lang.String"/>
            <arg column="status" javaType="java.lang.String"/>
            <arg column="amount" javaType="java.math.BigDecimal"/>
            <arg column="balance_before" javaType="java.math.BigDecimal"/>
            <arg column="balance_after" javaType="java.math.BigDecimal"/>
            <arg column="business_key" javaType="java.lang.String"/>
            <arg column="reason_code" javaType="java.lang.String"/>
            <arg column="operator_user_id" javaType="java.lang.String"/>
            <arg column="remark" javaType="java.lang.String"/>
            <arg column="occurred_at" javaType="java.sql.Timestamp"/>
        </constructor>
    </resultMap>
    <select id="selectPage" resultMap="selectPageRow" useCache="false" flushCache="true">
        SELECT b.id,
        b.advertiser_id,
        a.advertiser_name,
        b.monitor_task_id,
        t.monitor_name,
        b.event_fact_id,
        b.entry_type,
        b.status,
        b.amount,
        b.balance_before,
        b.balance_after,
        b.business_key,
        b.reason_code,
        b.operator_user_id,
        b.remark,
        b.occurred_at
        <include refid="filters"/>
        ORDER BY b.occurred_at DESC,
        b.id DESC LIMIT #{q.limit} OFFSET #{q.offset}
    </select>
</mapper>
