    <select id="selectSummary" resultMap="selectSummaryRow" useCache="false" flushCache="true">
        SELECT m.media_name,
        a.advertiser_name,
        p.link_name,
        t.monitor_name,
        dr.ratio AS link_radio,
        stat.*
        FROM (
        <include refid="summaryStat"/>
        ) AS stat
        JOIN scx_ocpx_media m ON m.id=stat.m_id
        JOIN scx_ocpx_advertiser a ON a.id=stat.a_id
        JOIN scx_ocpx_promotion_link p ON p.id=stat.l_id
        JOIN scx_ocpx_monitor_task t ON t.id=stat.t_id
        LEFT
        JOIN scx_ocpx_deduction_rule dr ON dr.media_id=stat.m_id AND dr.promotion_link_id=stat.l_id AND
        dr.is_delete=0
