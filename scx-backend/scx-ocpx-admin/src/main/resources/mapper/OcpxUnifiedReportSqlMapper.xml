<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yzytech.scx.ocpx.admin.mapper.OcpxUnifiedReportSqlMapper">
    <sql id="summaryPeriod">
        <choose>
            <when test="q.dateType == 0">
                r.time_hour
            </when>
            <when test="q.dateType == 1">
                LEFT(r.time_hour,
                8)
            </when>
            <when test="q.dateType == 2">
                LEFT(r.time_hour,
                6)
            </when>
            <otherwise>
                LEFT(r.time_hour,
                4)
            </otherwise>
        </choose>
    </sql>
    <sql id="summaryStat">
        SELECT
        <include refid="summaryPeriod"/>
        AS reportTime,
        r.media_id AS m_id,
        r.advertiser_id AS a_id,
        r.monitor_task_id AS t_id,
        r.promotion_link_id AS l_id,
        IFNULL(SUM(r.impression_count),
        0) AS uni_show_smt,
        IFNULL(SUM(r.click_count),
        0) AS uni_clk_smt,
        IFNULL(SUM(r.activate_count),
        0) AS activate,
        IFNULL(SUM(r.evoke_count),
        0) AS evoke,
        IFNULL(SUM(r.login_count),
        0) AS login,
        IFNULL(SUM(r.register_count),
        0) AS register,
        IFNULL(SUM(r.payment_count),
        0) AS payment,
        IFNULL(SUM(r.customer_acquisition_count),
        0) AS customer_acquisition,
        IFNULL(SUM(r.next_stay_count),
        0) AS next_stay,
        IFNULL(SUM(r.visits_count),
        0) AS visits,
        IFNULL(SUM(r.authentication_count),
        0) AS authentication,
        IFNULL(SUM(r.place_order_count),
        0) AS place_order,
        IFNULL(SUM(r.finish_the_order_count),
        0) AS finish_the_order,
        IFNULL(SUM(r.first_activation_count),
        0) AS first_activation,
        IFNULL(SUM(r.first_order_count),
        0) AS first_order,
        IFNULL(SUM(r.download_count),
        0) AS download,
        IFNULL(SUM(r.activity_count),
        0) AS activity,
        IFNULL(SUM(r.addiction_count),
        0) AS addiction,
        IFNULL(SUM(r.currency_amount),
        0) AS currency_amount,
        IFNULL(SUM(r.callback_count),
        0) AS callback_count,
        IFNULL(SUM(r.deduction_passed_count),
        0) AS deduction_passed_count,
        IFNULL(SUM(r.deduction_deducted_count),
        0) AS deduction_deducted_count,
        IFNULL(SUM(r.spend_amount),
        0) AS base_price,
        CASE WHEN SUM(r.impression_count)=0 THEN NULL ELSE ROUND(SUM(r.click_count)/SUM(r.impression_count)*100,
        6) END AS clickRate
        FROM scx_ocpx_hourly_metric r
        WHERE r.time_hour BETWEEN #{startHour} AND #{endHour}
        <if test="q.mediaId != null and !q.mediaId.isBlank()">
            AND r.media_id=#{q.mediaId}
        </if>
        <if test="q.monitorTaskId != null and !q.monitorTaskId.isBlank()">
            AND r.monitor_task_id=#{q.monitorTaskId}
        </if>
        <if test="q.advertiserId != null and !q.advertiserId.isBlank()">
            AND r.advertiser_id=#{q.advertiserId}
        </if>
        <if test="q.promotionLinkId != null and !q.promotionLinkId.isBlank()">
            AND r.promotion_link_id=#{q.promotionLinkId}
        </if>
        GROUP BY r.media_id,
        r.advertiser_id,
        r.monitor_task_id,
        r.promotion_link_id,
        <include refid="summaryPeriod"/>
    </sql>
    <select id="countSummary" resultType="java.lang.Long" useCache="false" flushCache="true">
        SELECT COUNT(*)
        FROM (
        <include refid="summaryStat"/>
        ) AS stat
    </select>
