    <select id="deductionCoverageStart" resultType="java.time.LocalDateTime" useCache="false" flushCache="true">
        SELECT MIN(deduction_decided_at)
        FROM scx_ocpx_event_fact
        WHERE flow_type='CALLBACK' AND deduction_decision IN ('PASSED',
        'DEDUCTED')
        <if test="q.mediaId != null and !q.mediaId.isBlank()">
            AND media_id=#{q.mediaId}
        </if>
        <if test="q.monitorTaskId != null and !q.monitorTaskId.isBlank()">
            AND monitor_task_id=#{q.monitorTaskId}
        </if>
        <if test="q.advertiserId != null and !q.advertiserId.isBlank()">
            AND advertiser_id=#{q.advertiserId}
        </if>
        <if test="q.promotionLinkId != null and !q.promotionLinkId.isBlank()">
            AND promotion_link_id=#{q.promotionLinkId}
        </if>
    </select>
    <select id="selectAdvertiserOptions" resultType="com.yzytech.scx.ocpx.admin.dto.UnifiedReportViews$Option" useCache="false" flushCache="true">
        SELECT id,
        advertiser_name AS name
        FROM scx_ocpx_advertiser
        <where>
            <if test="advertiserId != null and !advertiserId.isBlank()">
                id=#{advertiserId}
            </if>
        </where>
        ORDER BY advertiser_name
    </select>
    <select id="selectLinkOptions" resultType="com.yzytech.scx.ocpx.admin.dto.UnifiedReportViews$Option" useCache="false" flushCache="true">
        SELECT id,
        link_name AS name
        FROM scx_ocpx_promotion_link
        WHERE is_delete=0
        <if test="advertiserId != null and !advertiserId.isBlank()">
            AND advertiser_id=#{advertiserId}
        </if>
        ORDER BY link_name
    </select>
    <select id="selectMediaOptions" resultType="com.yzytech.scx.ocpx.admin.dto.UnifiedReportViews$Option" useCache="false" flushCache="true">
        SELECT DISTINCT m.id,
        m.media_name AS name
        FROM scx_ocpx_media m
        <if test="advertiserId != null and !advertiserId.isBlank()">
            JOIN scx_ocpx_monitor_task t ON t.media_id=m.id AND t.is_delete=0
            WHERE t.advertiser_id=#{advertiserId}
        </if>
        ORDER BY m.media_name
    </select>
    <select id="selectTaskOptions" resultType="com.yzytech.scx.ocpx.admin.dto.UnifiedReportViews$Option" useCache="false" flushCache="true">
        SELECT id,
        monitor_name AS name
        FROM scx_ocpx_monitor_task
        WHERE is_delete=0
        <if test="advertiserId != null and !advertiserId.isBlank()">
            AND advertiser_id=#{advertiserId}
        </if>
        <if test="mediaId != null and !mediaId.isBlank()">
            AND media_id=#{mediaId}
        </if>
        ORDER BY monitor_name
    </select>
    <resultMap id="accountActivity" type="com.yzytech.scx.ocpx.admin.mapper.OcpxUnifiedReportSqlMapper$AccountActivity">
        <constructor>
            <arg column="todaySpend" javaType="java.math.BigDecimal"/>
            <arg column="rejectedClickCount" javaType="_long"/>
            <arg column="rejectedConversionCount" javaType="_long"/>
        </constructor>
    </resultMap>
    <select id="accountActivity" resultMap="accountActivity" useCache="false" flushCache="true">
        SELECT IFNULL(SUM(spend_amount),
        0) AS todaySpend,
        IFNULL(SUM(rejected_click_count),
        0) AS rejectedClickCount,
        IFNULL(SUM(rejected_conversion_count),
        0) AS rejectedConversionCount
        FROM scx_ocpx_hourly_metric
        WHERE advertiser_id=#{advertiserId} AND time_hour BETWEEN #{start} AND #{end}
    </select>
    <select id="aggregateWatermark" resultType="java.time.LocalDateTime" useCache="false" flushCache="true">
        SELECT MAX(update_time)
        FROM scx_ocpx_hourly_metric r
        WHERE time_hour BETWEEN #{start} AND #{end}
        <if test="q.mediaId != null and !q.mediaId.isBlank()">
            AND r.media_id=#{q.mediaId}
        </if>
        <if test="q.monitorTaskId != null and !q.monitorTaskId.isBlank()">
            AND r.monitor_task_id=#{q.monitorTaskId}
        </if>
        <if test="q.advertiserId != null and !q.advertiserId.isBlank()">
            AND r.advertiser_id=#{q.advertiserId}
        </if>
        <if test="q.promotionLinkId != null and !q.promotionLinkId.isBlank()">
            AND r.promotion_link_id=#{q.promotionLinkId}
        </if>
    </select>
    <select id="countAdvertiser" resultType="java.lang.Long" useCache="false" flushCache="true">
        SELECT COUNT(*)
        FROM scx_ocpx_advertiser
        WHERE id=#{id}
    </select>
    <select id="countMedia" resultType="java.lang.Long" useCache="false" flushCache="true">
        SELECT COUNT(*)
        FROM scx_ocpx_media
        WHERE id=#{id}
    </select>
    <select id="countLink" resultType="java.lang.Long" useCache="false" flushCache="true">
        SELECT COUNT(*)
        FROM scx_ocpx_promotion_link
        WHERE id=#{q.promotionLinkId} AND is_delete=0
        <if test="q.advertiserId != null and !q.advertiserId.isBlank()">
            AND advertiser_id=#{q.advertiserId}
        </if>
    </select>
    <select id="countTask" resultType="java.lang.Long" useCache="false" flushCache="true">
        SELECT COUNT(*)
        FROM scx_ocpx_monitor_task r
        WHERE is_delete=0
        <if test="q.monitorTaskId != null and !q.monitorTaskId.isBlank()">
            AND id=#{q.monitorTaskId}
        </if>
        <if test="q.mediaId != null and !q.mediaId.isBlank()">
            AND r.media_id=#{q.mediaId}
        </if>
        <if test="q.advertiserId != null and !q.advertiserId.isBlank()">
            AND r.advertiser_id=#{q.advertiserId}
        </if>
        <if test="q.promotionLinkId != null and !q.promotionLinkId.isBlank()">
            AND r.promotion_link_id=#{q.promotionLinkId}
        </if>
    </select>
    <sql id="dimensionKey">
        <choose>
            <when test="q.groupBy == &#x27;ADVERTISER&#x27;">
                r.advertiser_id
            </when>
            <when test="q.groupBy == &#x27;PROMOTION_LINK&#x27;">
                r.promotion_link_id
            </when>
            <when test="q.groupBy == &#x27;MEDIA&#x27;">
                r.media_id
            </when>
            <when test="q.groupBy == &#x27;MONITOR_TASK&#x27;">
                r.monitor_task_id
            </when>
            <when test="q.groupBy == &#x27;TIME&#x27;">
                r.time_hour
            </when>
        </choose>
    </sql>
    <sql id="dimensionName">
        <choose>
            <when test="q.groupBy == &#x27;ADVERTISER&#x27;">
                a.advertiser_name
            </when>
            <when test="q.groupBy == &#x27;PROMOTION_LINK&#x27;">
                p.link_name
            </when>
            <when test="q.groupBy == &#x27;MEDIA&#x27;">
                m.media_name
            </when>
            <when test="q.groupBy == &#x27;MONITOR_TASK&#x27;">
                t.monitor_name
            </when>
            <when test="q.groupBy == &#x27;TIME&#x27;">
                DATE_FORMAT(STR_TO_DATE(CAST(r.time_hour AS CHAR),
                '%Y%m%d%H'),
                '%Y-%m-%d %H:00')
            </when>
        </choose>
    </sql>
    <sql id="dimensionJoins">
        <choose>
            <when test="q.groupBy == &#x27;ADVERTISER&#x27;">
                JOIN scx_ocpx_advertiser a ON a.id=r.advertiser_id
            </when>
            <when test="q.groupBy == &#x27;PROMOTION_LINK&#x27;">
                JOIN scx_ocpx_promotion_link p ON p.id=r.promotion_link_id
            </when>
            <when test="q.groupBy == &#x27;MEDIA&#x27;">
                JOIN scx_ocpx_media m ON m.id=r.media_id
            </when>
            <when test="q.groupBy == &#x27;MONITOR_TASK&#x27;">
                JOIN scx_ocpx_monitor_task t ON t.id=r.monitor_task_id
            </when>
            <when test="q.groupBy == &#x27;TIME&#x27;"/>
        </choose>
    </sql>
    <resultMap id="aggregate" type="com.yzytech.scx.ocpx.admin.mapper.OcpxUnifiedReportSqlMapper$Aggregate">
