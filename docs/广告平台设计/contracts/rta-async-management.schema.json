{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "RtaUpstreamConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 32
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "advertiserId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "accessCode": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{0,64}$"
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "credentialRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{0,64}$"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000,
          "default": 5000
        },
        "admissionSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400,
          "default": 300
        },
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "protocol": {
          "type": "string",
          "enum": [
            "GENERIC_ASYNC",
            "WEIFENG_RTA"
          ],
          "default": "GENERIC_ASYNC"
        },
        "protocolConfig": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "advertiserId",
        "name"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "protocol": {
                "const": "WEIFENG_RTA"
              }
            },
            "required": [
              "protocol"
            ]
          },
          "then": {
            "required": [
              "protocolConfig"
            ],
            "properties": {
              "endpoint": {
                "const": "https://rta.adapi.cn/rtaCommon/sendRta"
              },
              "credentialRef": {
                "const": ""
              },
              "protocolConfig": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "aid",
                  "did"
                ],
                "properties": {
                  "aid": {
                    "type": "string",
                    "pattern": "^[0-9]{1,32}$"
                  },
                  "did": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._-]{1,64}$"
                  }
                }
              }
            }
          },
          "else": {
            "required": [
              "endpoint",
              "credentialRef"
            ],
            "properties": {
              "credentialRef": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "protocolConfig": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        }
      ]
    },
    "RtaMediaConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mediaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "notifyUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "credentialRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "enabled": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "mediaId",
        "notifyUrl",
        "credentialRef"
      ]
    },
    "RtaBindingConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "monitorTaskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "upstreamId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "productId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "externalTaskId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "enabled": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "monitorTaskId",
        "upstreamId"
      ],
      "description": "Binding fields are validated against the selected upstream protocol. GENERIC_ASYNC requires productId/externalTaskId; WEIFENG_RTA derives its plan from access config."
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/RtaUpstreamConfig"
    },
    {
      "$ref": "#/$defs/RtaMediaConfig"
    },
    {
      "$ref": "#/$defs/RtaBindingConfig"
    }
  ]
}
