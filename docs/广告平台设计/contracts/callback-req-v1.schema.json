{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scx.local/contracts/callback-req-v1.schema.json",
  "title": "SCX CallbackReqV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "source_event_id", "event", "action_time", "monitor_id", "channel_id"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_id": { "type": "string" },
    "source_event_id": { "type": "string" },
    "event": { "type": "string", "enum": ["ACTIVATE", "FIRST_ACTIVATION", "EVOKE", "LOGIN", "REGISTER", "NEXT_DAY_RETENTION", "RETENTION_D3", "RETENTION_D4", "RETENTION_D5", "RETENTION_D6", "RETENTION_D7", "RETENTION", "PAYMENT", "REACTIVATION", "CUSTOMER_ACQUISITION", "VISIT", "AUTHENTICATION", "ORDER", "FIRST_ORDER", "FIRST_REACTIVATION", "COMPLETE_ORDER"] },
    "action_time": { "type": "string", "format": "date-time" },
    "amount": { "type": ["number", "null"] },
    "amount_raw": { "type": ["string", "null"] },
    "clickid": { "type": ["string", "null"] },
    "monitor_id": { "type": "string" },
    "channel_id": { "type": "string" },
    "ext": { "type": "object", "additionalProperties": true }
  }
}
