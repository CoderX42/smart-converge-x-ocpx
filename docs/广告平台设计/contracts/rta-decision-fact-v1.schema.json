{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scx.example.invalid/contracts/rta-decision-fact-v1.schema.json",
  "title": "SCX RTA decision fact stream event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "requestHash", "advertiserId", "promotionLinkId", "mediaId", "monitorTaskId", "adapterCode", "decision", "outcomeClass", "reasonCode", "latencyMs", "matchedTaskIds", "receivedAt", "completedAt"],
  "properties": {
    "requestId": { "type": "string", "maxLength": 128 },
    "requestHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "advertiserId": { "type": "string", "maxLength": 32 },
    "promotionLinkId": { "type": "string", "maxLength": 32 },
    "mediaId": { "type": "string", "maxLength": 32 },
    "monitorTaskId": { "type": "string", "maxLength": 32 },
    "profileId": { "type": ["string", "null"], "maxLength": 32 },
    "adapterCode": { "type": "string", "const": "MOCK" },
    "decision": { "type": "string", "enum": ["ALLOW", "DENY"] },
    "outcomeClass": { "type": "string", "enum": ["SUCCESS", "TIMEOUT", "ERROR", "REJECTED"] },
    "reasonCode": { "type": "string", "maxLength": 64 },
    "latencyMs": { "type": "integer", "minimum": 0 },
    "matchedTaskIds": { "type": "array", "items": { "type": "string", "maxLength": 128 } },
    "receivedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" }
  }
}
