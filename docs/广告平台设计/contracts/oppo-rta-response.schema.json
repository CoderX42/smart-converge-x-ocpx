{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OPPO synchronous strategy decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ret",
    "msg",
    "data"
  ],
  "properties": {
    "ret": {
      "type": "integer"
    },
    "msg": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "agree_type_list"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "agree_type_list": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      }
    }
  }
}
