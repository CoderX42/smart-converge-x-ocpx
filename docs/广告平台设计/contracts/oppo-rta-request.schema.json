{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OPPO strategy ID RTA request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "request_time",
    "channel_name",
    "ad_type_list",
    "sign"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "request_time": {
      "type": "integer"
    },
    "channel_name": {
      "const": "OPPO"
    },
    "sign": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{32}$"
    },
    "owner_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "oaid": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "client_ip": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "ad_type_list": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      }
    },
    "app_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "sex": {
      "type": [
        "integer",
        "null"
      ]
    },
    "age": {
      "type": [
        "integer",
        "null"
      ]
    },
    "city": {
      "type": [
        "string",
        "null"
      ]
    },
    "interest_tag_map": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "integer"
      }
    },
    "app_info_list": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "app_name",
          "app_status"
        ],
        "additionalProperties": false,
        "properties": {
          "app_name": {
            "type": "string"
          },
          "app_status": {
            "enum": [
              0,
              1
            ]
          }
        }
      }
    }
  }
}
