{
  "info": {
    "name": "SCX OCPX Feedback/Callback and Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "媒体 Feedback GET",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/ocpx/feedback?mId={{mediaId}}&tId={{monitorTaskId}}&aId={{advertiserId}}&lId={{promotionLinkId}}&event=CLK&request_id=click_demo&oaid=device_demo&callback_url={{downstreamCallbackUrl}}"
      }
    },
    {
      "name": "广告主 Callback GET",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/ocpx/callback?kid={{callbackKid}}&ext={{callbackExt}}&s={{promotionLinkId}}_{{monitorTaskId}}&event_type=1&event_time=1700000000"
      }
    },
    {
      "name": "AERIM Callback GET",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/ocpx/aerim/callback?kid={{callbackKid}}&ext={{callbackExt}}&s={{promotionLinkId}}_{{monitorTaskId}}&action_type=purchase&currency_amount=123.45"
      }
    },
    {
      "name": "微风互动 Callback GET",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/ocpx/weifeng/callback?kid={{callbackKid}}&ext={{callbackExt}}&s={{promotionLinkId}}_{{monitorTaskId}}&event=PAID&amount=123.45&days=__DAYS__"
      }
    },
    {
      "name": "引力 Callback GET",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/ocpx/gravity/callback?kid={{callbackKid}}&ctx={{gravityCallbackCtx}}"
      }
    },
    {
      "name": "人人视频 Callback GET",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/ocpx/renren-video/callback?kid={{callbackKid}}&ext={{callbackExt}}&event=activate"
      }
    },
    {
      "name": "凤凰新闻 PHOENIX Callback GET",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/ocpx/phoenix/callback?kid={{callbackKid}}&ext={{callbackExt}}&event_type=active"
      }
    },
    {
      "name": "读取共享广告主角色权限",
      "request": {
        "method": "GET",
        "header": [
          { "key": "satoken", "value": "Bearer {{adminToken}}", "type": "text" }
        ],
        "url": "{{adminBaseUrl}}/boot/ocpx/advertisers/account-role/permissions"
      }
    },
    {
      "name": "全量替换共享广告主角色权限",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "satoken", "value": "Bearer {{adminToken}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"menuIds\": [\"replace_with_menu_id\"],\n  \"allDataScope\": false\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{adminBaseUrl}}/boot/ocpx/advertisers/account-role/permissions"
      }
    },
    {
      "name": "广告主幂等充值",
      "request": {
        "method": "POST",
        "header": [
          { "key": "satoken", "value": "Bearer {{adminToken}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"requestId\": \"{{rechargeRequestId}}\",\n  \"amount\": 100.00,\n  \"remark\": \"local contract example\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{adminBaseUrl}}/boot/ocpx/advertisers/{{advertiserId}}/recharge"
      }
    },
    {
      "name": "广告主幂等扣减",
      "request": {
        "method": "POST",
        "header": [
          { "key": "satoken", "value": "Bearer {{adminToken}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"requestId\": \"{{deductionRequestId}}\",\n  \"amount\": 25.50,\n  \"remark\": \"local manual deduction example\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{adminBaseUrl}}/boot/ocpx/advertisers/{{advertiserId}}/deduct"
      }
    },
    {
      "name": "首页真实数据摘要",
      "request": {
        "method": "GET",
        "header": [
          { "key": "satoken", "value": "Bearer {{adminToken}}", "type": "text" }
        ],
        "url": "{{adminBaseUrl}}/boot/ocpx/dashboard/summary?startDate=2026-08-15&endDate=2026-08-15&advertiserId={{advertiserId}}"
      }
    },
    {
      "name": "查询创意列表",
      "request": {
        "method": "GET",
        "header": [
          { "key": "satoken", "value": "Bearer {{adminToken}}", "type": "text" }
        ],
        "url": "{{adminBaseUrl}}/boot/ocpx/creatives?advertiserId={{advertiserId}}&current=1&size=30"
      }
    },
    {
      "name": "上传创意素材",
      "request": {
        "method": "POST",
        "header": [
          { "key": "satoken", "value": "Bearer {{adminToken}}", "type": "text" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "advertiserId", "value": "{{advertiserId}}", "type": "text" },
            { "key": "file", "src": "{{creativeAssetPath}}", "type": "file" }
          ]
        },
        "url": "{{adminBaseUrl}}/boot/ocpx/creatives/assets"
      }
    },
    {
      "name": "创建图片创意",
      "request": {
        "method": "POST",
        "header": [
          { "key": "satoken", "value": "Bearer {{adminToken}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"advertiserId\": \"{{advertiserId}}\",\n  \"creativeName\": \"V111 local creative\",\n  \"sourceMaterialId\": \"{{sourceMaterialId}}\",\n  \"status\": 1,\n  \"promotionLinkIds\": [\"{{promotionLinkId}}\"],\n  \"remark\": \"local contract example\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{adminBaseUrl}}/boot/ocpx/creatives"
      }
    },
    {
      "name": "替换创意推广链接绑定",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "satoken", "value": "Bearer {{adminToken}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"promotionLinkIds\": [\"{{promotionLinkId}}\"]\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{adminBaseUrl}}/boot/ocpx/creatives/{{creativeId}}/promotion-links"
      }
    },
    {
      "name": "修改监测任务计费配置",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "satoken", "value": "Bearer {{adminToken}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"monitorName\": \"V111 billing task\",\n  \"advertiserId\": \"{{advertiserId}}\",\n  \"promotionLinkId\": \"{{promotionLinkId}}\",\n  \"mediaId\": \"{{mediaId}}\",\n  \"billingEnabled\": true,\n  \"billingType\": 2,\n  \"unitPrice\": 12.5,\n  \"conversionEvent\": \"ACTIVATE\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{adminBaseUrl}}/boot/ocpx/monitor-tasks/{{monitorTaskId}}"
      }
    },
    {
      "name": "查询上游协议允许域名",
      "request": {
        "method": "GET",
        "header": [
          { "key": "satoken", "value": "Bearer {{adminToken}}", "type": "text" }
        ],
        "url": "{{adminBaseUrl}}/boot/ocpx/protocol-configs"
      }
    },
    {
      "name": "替换 AERIM 允许域名",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "satoken", "value": "Bearer {{adminToken}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"allowedHosts\": [\"d.aerim.cn\", \"c.aerim.cn\"]\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{adminBaseUrl}}/boot/ocpx/protocol-configs/AERIM/allowed-hosts"
      }
    },
    {
      "name": "替换 GRAVITY 允许域名",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "satoken", "value": "Bearer {{adminToken}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"allowedHosts\": [\"backend.gravity-engine.com\"]\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{adminBaseUrl}}/boot/ocpx/protocol-configs/GRAVITY/allowed-hosts"
      }
    },
    {
      "name": "替换 RENREN_VIDEO 允许域名",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "satoken", "value": "Bearer {{adminToken}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"allowedHosts\": []\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{adminBaseUrl}}/boot/ocpx/protocol-configs/RENREN_VIDEO/allowed-hosts"
      }
    },
    {
      "name": "替换 PHOENIX 允许域名",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "satoken", "value": "Bearer {{adminToken}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"allowedHosts\": [\"api.feather.ifeng.com\"]\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{adminBaseUrl}}/boot/ocpx/protocol-configs/PHOENIX/allowed-hosts"
      }
    },
    {
      "name": "查询 V119 媒体快捷宏目录",
      "request": {
        "method": "GET",
        "header": [
          { "key": "satoken", "value": "Bearer {{adminToken}}", "type": "text" }
        ],
        "url": "{{adminBaseUrl}}/boot/ocpx/media-macros"
      }
    },
    {
      "name": "查询 V119 完整链路详情",
      "request": {
        "method": "GET",
        "header": [
          { "key": "satoken", "value": "Bearer {{adminToken}}", "type": "text" },
          { "key": "Cache-Control", "value": "no-store", "type": "text" }
        ],
        "url": "{{adminBaseUrl}}/boot/ocpx/flow-logs/{{flowLogId}}/request-detail"
      }
    },
    {
      "name": "查询广告主账务流水",
      "request": {
        "method": "GET",
        "header": [
          { "key": "satoken", "value": "Bearer {{adminToken}}", "type": "text" }
        ],
        "url": "{{adminBaseUrl}}/boot/ocpx/billing-entries?advertiserId={{advertiserId}}&current=1&size=30"
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:10000" },
    { "key": "adminBaseUrl", "value": "http://localhost:9999" },
    { "key": "adminToken", "value": "replace_with_local_admin_token" },
    { "key": "mediaId", "value": "replace_with_scx_media_id" },
    { "key": "monitorTaskId", "value": "replace_with_scx_monitor_task_id" },
    { "key": "advertiserId", "value": "replace_with_scx_advertiser_id" },
    { "key": "rechargeRequestId", "value": "replace_with_unique_request_id" },
    { "key": "deductionRequestId", "value": "replace_with_unique_request_id" },
    { "key": "promotionLinkId", "value": "replace_with_scx_promotion_link_id" },
    { "key": "creativeId", "value": "replace_with_scx_creative_id" },
    { "key": "sourceMaterialId", "value": "replace_with_uploaded_source_material_id" },
    { "key": "creativeAssetPath", "value": "replace_with_local_image_path" },
    { "key": "flowLogId", "value": "replace_with_flow_log_id" },
    { "key": "downstreamCallbackUrl", "value": "https%3A%2F%2Fsandbox.example.invalid%2Fcallback%3Fa%3D1" },
    { "key": "callbackKid", "value": "v1" },
    { "key": "callbackExt", "value": "replace_with_runtime_ext" },
    { "key": "gravityCallbackCtx", "value": "replace_with_runtime_authenticated_context" }
  ]
}
