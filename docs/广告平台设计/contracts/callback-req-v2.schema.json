{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "callback-req-v2.schema.json",
  "title": "Upstream Callback GET query parameters",
  "type": "object",
  "required": ["ext", "event_type", "event_time"],
  "properties": {
    "ext": { "type": "string", "minLength": 1 },
    "s": { "type": "string" },
    "event_type": { "type": "integer", "minimum": 1, "maximum": 17 },
    "event_time": { "type": "integer" }
  },
  "additionalProperties": false
}
