{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "relayRequestId",
    "deadline"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "relayRequestId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "deadline": {
      "type": "integer",
      "description": "Unix epoch milliseconds"
    }
  }
}
