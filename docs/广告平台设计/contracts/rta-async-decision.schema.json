{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "relayRequestId",
    "status",
    "matched"
  ],
  "properties": {
    "relayRequestId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "ALLOW",
        "DENY",
        "ERROR"
      ]
    },
    "matched": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productId",
          "taskId"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    }
  }
}
