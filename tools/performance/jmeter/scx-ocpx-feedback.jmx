<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="SCX OCPX Feedback no-loss load" enabled="true">
      <stringProp name="TestPlan.comments">Secrets are loaded from a chmod 600 temporary file. Request bodies are not persisted in JTL.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="Load ephemeral secret" enabled="true">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </SetupThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Read secret file once" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.nio.file.Files
import java.nio.file.Path
import java.util.concurrent.atomic.AtomicLong

String secretFile = props.getProperty('secretFile')
if (secretFile == null || secretFile.isBlank()) {
    throw new IllegalStateException('secretFile property is required')
}
props.put('scx.secret', Files.readString(Path.of(secretFile)).trim())
props.put('scx.sequence', new AtomicLong(0L))
SampleResult.setResponseCode('200')
SampleResult.setSuccessful(true)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Feedback load" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">true</boolProp>
          <stringProp name="LoopController.loops">-1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(threads,256)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(ramp,5)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(duration,60)}</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <ConstantThroughputTimer guiclass="TestBeanGUI" testclass="ConstantThroughputTimer" testname="Target requests per minute" enabled="true">
        <stringProp name="throughput">${__P(tpm,6000)}</stringProp>
          <intProp name="calcMode">1</intProp>
        </ConstantThroughputTimer>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST FeedbackReqV1" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">${requestBody}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.domain">127.0.0.1</stringProp>
          <stringProp name="HTTPSampler.port">19999</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.path">/ocpx/open-api/ocpx/v1/channels/perf-channel/feedback</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <stringProp name="HTTPSampler.connect_timeout">3000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">5000</stringProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate signed synthetic event" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonOutput
import java.nio.charset.StandardCharsets
import java.security.MessageDigest
import java.util.UUID
import java.util.concurrent.atomic.AtomicLong
import javax.crypto.Mac
import javax.crypto.spec.SecretKeySpec

AtomicLong sequence = (AtomicLong) props.get('scx.sequence')
long number = sequence.incrementAndGet()
String runId = props.getProperty('runId', 'local')
String eventId = runId + '-' + number
int devicePool = Integer.parseInt(props.getProperty('devicePool', '0'))
String deviceSuffix = devicePool &gt; 0 ? Long.toString(number % devicePool) : eventId
boolean android = number % 2 == 0
Map bodyMap = [
    schema_version: '1.0',
    event_id: eventId,
    event: 'click',
    monitor_id: 'perf_monitor_id',
    clickid: 'click-' + eventId,
    event_time: System.currentTimeMillis(),
    ip: '192.0.2.10',
    ua: 'SCX-JMeter/1.0',
    os: android ? 'android' : 'ios',
    creative_id: 'synthetic-creative'
]
if (android) {
    bodyMap.oaid = 'synthetic-android-' + deviceSuffix
} else {
    bodyMap.idfa = 'synthetic-ios-' + deviceSuffix
}
String body = JsonOutput.toJson(bodyMap)
String timestamp = Long.toString(System.currentTimeMillis())
String nonce = UUID.randomUUID().toString().replace('-', '')
MessageDigest digest = MessageDigest.getInstance('SHA-256')
String bodyHash = digest.digest(body.getBytes(StandardCharsets.UTF_8)).collect { String.format('%02x', it) }.join()
String path = '/ocpx/open-api/ocpx/v1/channels/perf-channel/feedback'
String canonical = 'POST\n' + path + '\n' + timestamp + '\n' + nonce + '\n' + bodyHash
Mac mac = Mac.getInstance('HmacSHA256')
mac.init(new SecretKeySpec(((String) props.get('scx.secret')).getBytes(StandardCharsets.UTF_8), 'HmacSHA256'))
String signature = mac.doFinal(canonical.getBytes(StandardCharsets.UTF_8)).collect { String.format('%02x', it) }.join()
vars.put('requestBody', body)
vars.put('requestTimestamp', timestamp)
vars.put('requestNonce', nonce)
vars.put('requestSignature', signature)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HMAC headers" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="Content-Type" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
              <elementProp name="X-Client-Id" elementType="Header">
                <stringProp name="Header.name">X-Client-Id</stringProp>
                <stringProp name="Header.value">perf-channel</stringProp>
              </elementProp>
              <elementProp name="X-Key-Version" elementType="Header">
                <stringProp name="Header.name">X-Key-Version</stringProp>
                <stringProp name="Header.value">1</stringProp>
              </elementProp>
              <elementProp name="X-Timestamp" elementType="Header">
                <stringProp name="Header.name">X-Timestamp</stringProp>
                <stringProp name="Header.value">${requestTimestamp}</stringProp>
              </elementProp>
              <elementProp name="X-Nonce" elementType="Header">
                <stringProp name="Header.name">X-Nonce</stringProp>
                <stringProp name="Header.value">${requestNonce}</stringProp>
              </elementProp>
              <elementProp name="X-Sign" elementType="Header">
                <stringProp name="Header.name">X-Sign</stringProp>
                <stringProp name="Header.value">${requestSignature}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Only HTTP 202 is expected" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="202">202</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">capacity stage requires a newly accepted event</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
