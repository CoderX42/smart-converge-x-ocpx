[Unit]
Description=Smart Converge X (scx-boot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/scx/scx.env
WorkingDirectory=/opt/smart-converge-x
ExecStart=/bin/bash /opt/smart-converge-x/scripts/deploy/run-boot.sh
Restart=on-failure
RestartSec=8
SuccessExitStatus=143
LimitNOFILE=65535
StandardOutput=append:/var/log/scx/scx-boot.out.log
StandardError=append:/var/log/scx/scx-boot.err.log
TimeoutStopSec=60
KillMode=mixed

[Install]
WantedBy=multi-user.target
