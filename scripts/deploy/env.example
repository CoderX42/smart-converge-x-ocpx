# SCX 部署环境变量（复制为 /etc/scx/scx.env 后按需修改）
# 用法：cp scripts/deploy/env.example /etc/scx/scx.env && vim /etc/scx/scx.env

# 代码与运行目录
SCX_HOME=/opt/smart-converge-x
SCX_BRANCH=main
SCX_GIT_URL=git@gitea.smartcute.cn:karl419/smart-converge-x.git

# 后端
SCX_PROFILE=prod
SCX_JAVA_OPTS=-Xms512m -Xmx1024m -Dfile.encoding=UTF-8
SCX_JAR=${SCX_HOME}/scx-backend/scx-boot/target/scx-boot.jar
SCX_LOG_DIR=/var/log/scx
SCX_HEALTH_URL=http://127.0.0.1:9999/boot/actuator/health

# 前端静态资源落地目录（Nginx root）
SCX_WEB_ROOT=/var/www/scx

# 数据库迁移（与 application-prod.yml 保持一致）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# 是否在 update 时执行数据库迁移：true/false
SCX_RUN_DB_MIGRATE=true

# 构建：是否跳过前端构建（仅后端热更时用）
SCX_SKIP_FRONTEND=false
# 构建：是否跳过后端构建
SCX_SKIP_BACKEND=false
