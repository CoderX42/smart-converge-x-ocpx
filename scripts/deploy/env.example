# Copy to /etc/scx/scx.env and replace every placeholder through the deployment
# secret manager. Never commit a populated copy.

SCX_HOME=/opt/smart-converge-x
SCX_BRANCH=main
SCX_GIT_URL=replace-with-git-remote

SCX_PROFILE=prod
SCX_JAVA_OPTS=-Xms512m -Xmx1024m -Dfile.encoding=UTF-8
SCX_JAR=/opt/smart-converge-x/scx-backend/scx-boot/target/scx-boot.jar
SCX_LOG_DIR=/var/log/scx
SCX_HEALTH_URL=http://127.0.0.1:9999/boot/actuator/health
# 宝塔站点根优先，例如 /www/wwwroot/scx；纯系统可用 /var/www/scx
SCX_WEB_ROOT=/www/wwwroot/scx

SCX_DATASOURCE_URL=jdbc:mysql://mysql-host:3306/smart_converge_x?characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=true&serverTimezone=Asia%2FShanghai&allowMultiQueries=true
SCX_DATASOURCE_USERNAME=replace-me
SCX_DATASOURCE_PASSWORD=replace-me

MYSQL_HOST=mysql-host
MYSQL_PORT=3306
MYSQL_USERNAME=replace-me
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=smart_converge_x

SCX_REDIS_HOST=redis-host
SCX_REDIS_PORT=6379
SCX_REDIS_USERNAME=replace-me
SCX_REDIS_PASSWORD=replace-me
SCX_REDIS_DATABASE=0

ROCKETMQ_NAME_SERVER=rocketmq-host:9876
SCX_ROCKETMQ_PRODUCER_GROUP=producer_group

SCX_XXL_JOB_ADMIN_ADDRESSES=http://127.0.0.1:8080
SCX_XXL_JOB_ACCESS_TOKEN=replace-me
SCX_XXL_JOB_EXECUTOR_PORT=9009
SCX_ENCODE_KEY=replace-me
SCX_TRACKING_CHANNEL_MASTER_KEY=replace-with-base64-32-byte-key
SCX_TRACKING_DEVICE_HMAC_KEY=replace-with-base64-at-least-32-byte-key
SCX_TRACKING_CALLBACK_SANDBOX_ENDPOINT=
SCX_TRACKING_CALLBACK_ALLOWED_HOSTS=
# Keep both switches off until RocketMQ/Outbox recovery has been explicitly
# reconciled in the controlled window. Enable one at a time from the external
# secret/config manager; never commit an enabled production value.
SCX_TRACKING_OUTBOX_PUBLISHER_ENABLED=false
SCX_TRACKING_OUTBOX_SCHEDULER_ENABLED=false

SCX_RUN_DB_MIGRATE=true
SCX_SKIP_FRONTEND=false
SCX_SKIP_BACKEND=false

XXL_JOB_HOME=/opt/xxl-job-admin
XXL_JOB_PORT=8080
XXL_JOB_ACCESS_TOKEN=replace-me
XXL_SSO_TOKEN_KEY=replace-me
XXL_JOB_JAVA_OPTS=-Xms256m -Xmx512m -Dfile.encoding=UTF-8
