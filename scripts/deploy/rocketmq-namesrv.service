[Unit]
Description=Apache RocketMQ NameServer (SCX local-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rocketmq
Group=rocketmq
Environment="JAVA_OPT_EXT=-server -Xms256m -Xmx256m -Xmn128m"
ExecStart=/opt/rocketmq/bin/mqnamesrv -c /etc/rocketmq/namesrv.conf
ExecStop=/opt/rocketmq/bin/mqshutdown namesrv
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
TimeoutStopSec=60
SuccessExitStatus=143
IPAddressDeny=any
IPAddressAllow=localhost
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/rocketmq /var/log/rocketmq
StandardOutput=append:/var/log/rocketmq/namesrv.out.log
StandardError=append:/var/log/rocketmq/namesrv.err.log

[Install]
WantedBy=multi-user.target
