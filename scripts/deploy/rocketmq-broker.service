[Unit]
Description=Apache RocketMQ Broker (SCX local-only)
After=network-online.target rocketmq-namesrv.service
Requires=rocketmq-namesrv.service

[Service]
Type=simple
User=rocketmq
Group=rocketmq
Environment="JAVA_OPT_EXT=-server -Xms1024m -Xmx1024m -Xmn512m"
ExecStart=/opt/rocketmq/bin/mqbroker -c /etc/rocketmq/broker.conf
ExecStop=/opt/rocketmq/bin/mqshutdown broker
Restart=on-failure
RestartSec=8
LimitNOFILE=65535
TimeoutStopSec=90
SuccessExitStatus=143
IPAddressDeny=any
IPAddressAllow=localhost
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/rocketmq /var/log/rocketmq
StandardOutput=append:/var/log/rocketmq/broker.out.log
StandardError=append:/var/log/rocketmq/broker.err.log

[Install]
WantedBy=multi-user.target
